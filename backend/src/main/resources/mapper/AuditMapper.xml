<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.paperflow.adapters.persistence.AuditMapper">
    <resultMap id="event" type="com.paperflow.audit.model.AuditEvent">
        <constructor>
            <idArg name="eventId" column="event_id" javaType="_long" />
            <arg name="occurredAt" column="occurred_at" javaType="java.time.OffsetDateTime" />
            <arg name="actor" column="actor" javaType="String" />
            <arg name="action" column="action" javaType="String" />
            <arg name="objectType" column="object_type" javaType="String" />
            <arg name="objectId" column="object_id" javaType="String" />
            <arg name="outcome" column="outcome" javaType="com.paperflow.audit.model.AuditOutcome" />
            <arg name="summary" column="summary" javaType="java.util.Map"
                 typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler" />
        </constructor>
    </resultMap>
    <sql id="fields">
        event_id, occurred_at, actor, action, object_type, object_id, outcome
    </sql>
    <sql id="filters">
        <where>
            <if test="filter.from != null">AND occurred_at &gt;= #{filter.from}</if>
            <if test="filter.to != null">AND occurred_at &lt;= #{filter.to}</if>
            <if test="filter.actor != null">AND actor = #{filter.actor}</if>
            <if test="filter.action != null">AND action = #{filter.action}</if>
            <if test="filter.objectType != null">AND object_type = #{filter.objectType}</if>
            <if test="filter.objectId != null">AND object_id = #{filter.objectId}</if>
            <if test="filter.outcome != null">AND outcome = #{filter.outcome}</if>
        </where>
    </sql>
    <insert id="record">
        INSERT INTO v2_audit_event (actor, action, object_type, object_id, outcome, summary)
        VALUES (#{actor}, #{action}, #{objectType}, #{objectId}, #{outcome},
                CAST(#{summary, javaType=java.util.Map, typeHandler=com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler} AS jsonb))
    </insert>
    <select id="list" resultMap="event">
        SELECT <include refid="fields"/>, NULL AS summary FROM v2_audit_event
        <include refid="filters"/>
        ORDER BY occurred_at DESC, event_id DESC LIMIT #{size} OFFSET #{offset}
    </select>
    <select id="count" resultType="long" parameterType="com.paperflow.audit.model.AuditFilter">
        SELECT count(*) FROM v2_audit_event <include refid="filters"/>
    </select>
    <select id="find" resultMap="event">
        SELECT <include refid="fields"/>, summary::text AS summary FROM v2_audit_event WHERE event_id = #{eventId}
    </select>
</mapper>
