# PostgreSQL 连接沿用旧项目的 PAPERFLOW_DB_* 配置。JDBC URL 可覆盖这些字段。
PAPERFLOW_DB_HOST=127.0.0.1
PAPERFLOW_DB_PORT=5432
PAPERFLOW_DB_NAME=openalex
PAPERFLOW_DB_SCHEMA=widi_chengyan
PAPERFLOW_DB_USER=
PAPERFLOW_DB_PASSWORD=
OPENALEX_DB_SCHEMA=dataset_20241125

# 绝对路径。历史目录沿用旧项目的 DATA_ROOT。
PAPERFLOW_LEGACY_STORAGE=/path/to/legacy/data
PAPERFLOW_STORAGE=/path/to/paperflow-v2/data

PAPERFLOW_MINERU_GPU=0
PAPERFLOW_MINERU_PORT=18002
# 后端默认使用上述本机端口。需要连接其他地址时才配置 PAPERFLOW_MINERU_URL。
# 留空使用 MinerU 服务的默认档位。
PAPERFLOW_MINERU_TIER=
PAPERFLOW_PORT=8095
# 首次创建管理员时，用户名为 3–50 位字母、数字或 ._-。
# 密码至少 12 个字符，UTF-8 编码最多 72 字节。
PAPERFLOW_ADMIN_USERNAME=
PAPERFLOW_ADMIN_PASSWORD=
