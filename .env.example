# PostgreSQL 连接沿用旧项目的 PAPERFLOW_DB_* 配置。JDBC URL 可覆盖这些字段。
PAPERFLOW_DB_HOST=127.0.0.1
PAPERFLOW_DB_PORT=5432
PAPERFLOW_DB_NAME=openalex
PAPERFLOW_DB_SCHEMA=widi_chengyan
PAPERFLOW_DB_USER=
PAPERFLOW_DB_PASSWORD=
OPENALEX_DB_SCHEMA=dataset_20241125

# 绝对路径。历史目录沿用旧项目的 DATA_ROOT。
PAPERFLOW_LEGACY_STORAGE=/path/to/legacy/data
PAPERFLOW_STORAGE=/path/to/paperflow-v2/data

PAPERFLOW_MINERU_GPU=0
PAPERFLOW_MINERU_PORT=18002
# 后端默认使用上述本机端口。需要连接其他地址时才配置 PAPERFLOW_MINERU_URL。
# 留空使用 MinerU 服务的默认档位。
PAPERFLOW_MINERU_TIER=
PAPERFLOW_PORT=8095
# 首次创建管理员时，用户名为 3–50 位字母、数字或 ._-。
# 密码至少 12 个字符，UTF-8 编码最多 72 字节。
PAPERFLOW_ADMIN_USERNAME=
PAPERFLOW_ADMIN_PASSWORD=

# 因果知识图谱与抽取引擎配置（默认关闭抽取，仅开放图谱只读查询）
PAPERFLOW_CAUSAL_ENABLED=false
PAPERFLOW_CAUSAL_DEFAULT_MODE=RAW
PAPERFLOW_CAUSAL_ENGINE_PORT=18003
# PAPERFLOW_CAUSAL_ENGINE_URL=http://127.0.0.1:18003
PAPERFLOW_CAUSAL_CONCURRENCY=2
PAPERFLOW_CAUSAL_MAX_CALLS=2000
PAPERFLOW_CAUSAL_MAX_BATCH_TARGETS=500

# 可选：因果库独立于主库时设置，留空逐项回退到 PAPERFLOW_DB_*
# CAUSAL_DB_HOST=
# CAUSAL_DB_PORT=5432
# CAUSAL_DB_NAME=openalex
# CAUSAL_DB_SCHEMA=widi_chengyan
# CAUSAL_DB_USER=
# CAUSAL_DB_PASSWORD=

# 因果抽取引擎（causal-engine）模型凭据，仅注入 Python 引擎服务，不向 Java 后端暴露
# CAUSAL_CHAT_API_KEY=
# CAUSAL_EMBEDDING_API_KEY=

# 客户端科研工作台能力引擎配置（参考文献自动标注默认启用内置 stub 演示驱动）
# 可选 provider：stub | citations-retrieval-v1 | standard-v1 | disabled
PAPERFLOW_CLIENT_CITATIONS_PROVIDER=stub
# PAPERFLOW_CLIENT_CITATIONS_ENGINE_URL=http://127.0.0.1:8000
PAPERFLOW_CLIENT_CITATIONS_TIMEOUT=PT10M
PAPERFLOW_CLIENT_CITATIONS_POLL_INTERVAL=PT1.5S
PAPERFLOW_CLIENT_CITATIONS_MAX_ACTIVE=3
PAPERFLOW_CLIENT_CITATIONS_CONCURRENCY=4
PAPERFLOW_CLIENT_QA_ENABLED=false
# PAPERFLOW_CLIENT_QA_ENGINE_URL=
PAPERFLOW_CLIENT_WRITING_ENABLED=false
# PAPERFLOW_CLIENT_WRITING_ENGINE_URL=
